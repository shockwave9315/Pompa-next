# Pompa Next runtime configuration. Copy to .env and fill in; never commit .env.

# MQTT broker (read-only consumer; distinct client id from legacy).
# Use host.docker.internal for a broker running on the Docker host itself.
MQTT_HOST=192.0.2.10
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=pompa-next
MQTT_TOPIC_PREFIX=panasonic_heat_pump

# Separate database served by the compose "db" service.
DB_NAME=pompa_next
DB_USER=pompa_next
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# API port, distinct from legacy.
API_PORT=8001

# Stage 1 bootstrap value only; the >=24h measurement decides the policy.
STALE_AFTER_SECONDS=600
WRITE_BUFFER_ROWS=60
LOG_LEVEL=INFO

# Container local time. Storage, API timestamps and logs are UTC.
TZ=Europe/Warsaw
